#define DEBUG
#include "espConfig.h" 
#include <DHT.h>

#define DHTPIN 22         
#define DHTTYPE DHT22      
#define relayPin 5        
#define button 15          
#define MQ2_PIN 34        

int mucCanhbao;            
float tempThreshold = 32.0; 
BlynkTimer timer;
int timerID1, timerID2;
float mq2_value;
boolean buttonState = HIGH;
boolean runMode = 0;       
boolean canhbaoState = 0;

#define GAS V1
#define MUCCANHBAO V2
#define CANHBAO V3
#define CHEDO V4
#define TEMP V5            
#define HUMID V6         

DHT dht(DHTPIN, DHTTYPE);

void setup() {
  Serial.begin(115200);
  pinMode(button, INPUT_PULLUP);   
  pinMode(relayPin, OUTPUT);
  digitalWrite(relayPin, HIGH);    
  dht.begin();                     
  timerID1 = timer.setInterval(1000L, handleTimerID1); 
  espConfig.begin();               
}

void loop() {
  espConfig.run();
  app_loop();
}

void app_loop() {
  timer.run();
  if (digitalRead(button) == LOW) {  
    if (buttonState == HIGH) {
      buttonState = LOW;
      runMode = !runMode;           
      Serial.println("Run mode: " + String(runMode));
      Blynk.virtualWrite(CHEDO, runMode);
      delay(200);                    
    }
  } else {
    buttonState = HIGH;
  }
}

void handleTimerID1() {
  int mq2 = analogRead(MQ2_PIN);
  float voltage = mq2 / 4095.0 * 3.3; // ESP32: ADC 12-bit, nguồn 3.3V
  float ratio = voltage / 1.4;
  mq2_value = 1000.0 * pow(10, ((log10(ratio) - 1.0278) / 0.6629));
  Serial.println("Gas: " + String(mq2_value, 0) + "ppm");
  Blynk.virtualWrite(GAS, mq2_value);

  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();
  if (isnan(temperature) || isnan(humidity)) {
    Serial.println("Lỗi cảm biến DHT22!");
    return;
  }
  Serial.println("Nhiệt độ: " + String(temperature) + "°C, Độ ẩm: " + String(humidity) + "%");
  Blynk.virtualWrite(TEMP, temperature);
  Blynk.virtualWrite(HUMID, humidity);

  if (runMode == 1) {
    if (mq2_value > mucCanhbao || temperature > tempThreshold) {
      if (canhbaoState == 0) {
        canhbaoState = 1;
        String message = "Cảnh báo! ";
        if (mq2_value > mucCanhbao) {
          message += "Khí gas=" + String(mq2_value) + "ppm ";
        }
        if (temperature > tempThreshold) {
          message += "Nhiệt độ=" + String(temperature) + "°C";
        }
        Blynk.logEvent("canhbao", message); // Gửi thông báo qua Blynk
        timerID2 = timer.setTimeout(60000L, handleTimerID2); // Đặt timeout 60 giây
      }
      canh_bao(); // Kích hoạt còi 12V
      Blynk.virtualWrite(CANHBAO, HIGH);
      Serial.println("Đã bật cảnh báo!");
    } else {
      digitalWrite(relayPin, HIGH); // Tắt còi
      Blynk.virtualWrite(CANHBAO, LOW);
      Serial.println("Đã tắt cảnh báo!");
    }
  } else {
    digitalWrite(relayPin, HIGH); // Tắt còi khi chế độ cảnh báo tắt
    Blynk.virtualWrite(CANHBAO, LOW);
    Serial.println("Đã tắt cảnh báo!");
  }
}

void handleTimerID2() {
  canhbaoState = 0; // Reset trạng thái cảnh báo sau 60 giây
}

void canh_bao() {
  digitalWrite(relayPin, LOW);  // Bật còi 12V qua relay
  delay(8000);                  // Bật trong 8 giây
  digitalWrite(relayPin, HIGH); // Tắt còi
  delay(8000);                  // Tắt trong 8 giây
}

BLYNK_CONNECTED() {
  Blynk.syncAll(); // Đồng bộ dữ liệu khi kết nối
}

BLYNK_WRITE(MUCCANHBAO) {
  mucCanhbao = param.asInt(); // Nhận mức cảnh báo từ Blynk
}

BLYNK_WRITE(CHEDO) {
  runMode = param.asInt(); // Nhận trạng thái chế độ từ Blynk
}
